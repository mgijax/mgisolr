<?xml version="1.0" encoding="UTF-8" ?>
<schema name="authorsAC" version="1.7">
  
  <!-- Field Types -->
  <fieldType name="ancestor_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
  </fieldType>
  <fieldType name="binary" class="solr.BinaryField"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="descendent_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="ignored" class="solr.StrField" indexed="false" stored="false" multiValued="true"/>
 
<!-- TODO: These fail on load (-pf) 
 <fieldType name="location" class="solr.LatLonType" subFieldSuffix="_coordinate"/>
  <fieldType name="location_rpt" class="solr.SpatialRecursivePrefixTreeFieldType" geo="true" maxDistErr="0.001" distErrPct="0.025" distanceUnits="kilometers"/>
-->

<fieldType name="lowercase" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="phonetic_en" class="solr.TextField" indexed="true" stored="false">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.DoubleMetaphoneFilterFactory" inject="false"/>
    </analyzer>
  </fieldType>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="point" class="solr.PointType" subFieldSuffix="_d" dimension="2"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>    
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>



<!-- begin custom data for this index -->
  <fieldType name="nomen" class="solr.TextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
    </analyzer>
  </fieldType>

  <fieldType name="pheno" class="solr.TextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
    </analyzer>
  </fieldType>

  <fieldType name="textTight" class="solr.TextField" positionIncrementGap="100" >
    <analyzer>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <!-- this filter can remove any duplicate tokens that appear at the same position - sometimes
           possible with WordDelimiterFilter in conjuncton with stemming. -->
      <filter class="solr.RemoveDuplicatesTokenFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- *** fields specific to HPO annotations (source disease + marker) *** -->

  <field name="markerSymbol" type="nomen" indexed="true" stored="true" />
  <field name="markerMgiId" type="textTight" indexed="true" stored="true" />

  <field name="sourceTerm" type="pheno" indexed="true" stored="true" />
  <field name="sourceTermId" type="pheno" indexed="true" stored="true" />

  <!-- *** end fields specific to HPO annotations *** -->

  <!-- *** now fields specific to grid annotations *** -->

  <!-- uniquely identifies this document -->
  <field name="uniqueKey" type="string" indexed="true" stored="true" />

  <!-- the "primary key" for this document, identifying uniquely this
       genocluster (for mouse data) or the marker/disease pair (for human
       data) -->
  <field name="gridKey" type="pint" indexed="true" stored="true" />

  <field name="gridClusterKey" type="pint" indexed="true" stored="true" />

  <!-- the annotated term, its type, and its primary ID -->
  <field name="term" type="string" indexed="true" stored="true" />
  <field name="termId" type="string" indexed="true" stored="true" />
  <field name="termType" type="string" indexed="true" stored="true" />

  <!-- the header term for annotated term; if term has more than one header,
       we represent it with multiple documents -->
  <field name="termHeader" type="string" indexed="true" stored="true" />

  <!-- qualifier applied to the annotation -->
  <field name="qualifier" type="string" indexed="true" stored="true" />

  <!-- non-null if annotation is background sensitive -->
  <field name="backgroundSensitive" type="string" indexed="true" stored="true" />

  <!-- sequence numbers for ordering documents by terms or header terms -->
  <field name="byTermDag" type="pint" indexed="true" stored="true" />
  <field name="byTermName" type="pint" indexed="true" stored="false" />
  <field name="byTermHeader" type="pint" indexed="true" stored="false" />

  <!-- fields to help with highlighting -->

  <!-- tSy =  termSynonym; shortened for efficiency -->
  <field name="tSy" type="pheno" indexed="true" stored="false" multiValued="true" />
  <!-- tAtext =  termAncestor (text only) -->
  <field name="tAtext" type="pheno" indexed="true" stored="false" multiValued="true" />
  <!-- tAid =  termAncestor (IDs only) -->
  <field name="tAid" type="textTight" indexed="true" stored="false" multiValued="true" />
  <!-- altTermId = alternate IDs for the term -->
  <field name="altTermId" type="pheno" indexed="true" stored="false" multiValued="true" />

  <!-- tsHtext : collection of text fields to consider for highlighting -->
  <field name="tsHtext" type="pheno" indexed="true" stored="false" multiValued="true" />
  <!-- tsHid : collection of ID fields to consider for highlighting -->
  <field name="tsHid" type="pheno" indexed="true" stored="false" multiValued="true" />

  <!-- *** end of grid annotation-specific fields *** -->

  <!-- This is a Solr-required field -->
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <copyField source="term" dest="tsHtext"/>
  <copyField source="tSy" dest="tsHtext"/>
  <copyField source="tAtext" dest="tsHtext"/>

  <copyField source="termId" dest="tsHid"/>
  <copyField source="altTermId" dest="tsHid"/>
  <copyField source="tAid" dest="tsHid"/>

  <uniqueKey>uniqueKey</uniqueKey>

<!-- end custom data for this index -->




</schema>
