<?xml version="1.0" encoding="UTF-8" ?>
<schema name="marker" version="1.7">
  
  <!-- Field Types -->
  <fieldType name="ancestor_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
  </fieldType>
  <fieldType name="binary" class="solr.BinaryField"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="descendent_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="ignored" class="solr.StrField" indexed="false" stored="false" multiValued="true"/>
 
<!-- TODO: These fail on load (-pf) 
 <fieldType name="location" class="solr.LatLonType" subFieldSuffix="_coordinate"/>
  <fieldType name="location_rpt" class="solr.SpatialRecursivePrefixTreeFieldType" geo="true" maxDistErr="0.001" distErrPct="0.025" distanceUnits="kilometers"/>
-->

  <fieldType name="lowercase" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="phonetic_en" class="solr.TextField" indexed="true" stored="false">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.DoubleMetaphoneFilterFactory" inject="false"/>
    </analyzer>
  </fieldType>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="point" class="solr.PointType" subFieldSuffix="_d" dimension="2"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>    
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>



<!-- begin custom data for this index -->

  <fieldType name="text" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <!-- Case insensitive stop word removal.
        add enablePositionIncrements=true in both the index and query
        analyzers to leave a 'gap' for more accurate phrase queries.
      -->
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" catenateAll="0" splitOnCaseChange="0" splitOnNumerics="0" preserveOriginal="1"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.KeywordRepeatFilterFactory"/>
      <filter class="solr.SnowballPorterFilterFactory" language="English" />
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="0" catenateNumbers="0" catenateAll="0" splitOnCaseChange="0" splitOnNumerics="0" preserveOriginal="1"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.SnowballPorterFilterFactory" language="English" />
    </analyzer>
  </fieldType>

  <fieldType name="textTight" class="solr.TextField" positionIncrementGap="100" >
    <analyzer>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <!-- this filter can remove any duplicate tokens that appear at the same position - sometimes
           possible with WordDelimiterFilter in conjuncton with stemming. -->
      <filter class="solr.RemoveDuplicatesTokenFilterFactory"/>
    </analyzer>
  </fieldType>

  <fieldType name="nomen" class="solr.TextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
    </analyzer>
  </fieldType>

  <field name="markerKey" type="string" indexed="true" stored="true" required="true" />
  <!-- to query by MGIID use markerID -->
  <field name="markerPrimaryID" type="string" indexed="false" stored="true" required="true" />
  <field name="markerID" type="textTight" indexed="true" stored="false" multiValued="true"/>
  <field name="markerSymbol" type="textTight" indexed="true" stored="true" />
  <field name="markerType" type="lowercase" indexed="true" stored="true" />
  <field name="featureType" type="lowercase" indexed="true" stored="true" />
  <field name="featureTypeKey" type="string" indexed="true" stored="false" />
  <field name="markerName" type="textTight" indexed="true" stored="true" />
  <field name="markerStatus" type="lowercase" indexed="true" stored="false" />
  <field name="markerOrganism" type="textTight" indexed="true" stored="false" />

  <!-- text searches -->
  <field name="markerNomen" type="nomen" indexed="true" stored="false" multiValued="true"/>
  <field name="goProcessTerm" type="text" indexed="true" stored="true" multiValued="true" omitNorms="true" />
  <field name="goFunctionTerm" type="text" indexed="true" stored="true" multiValued="true" omitNorms="true" />
  <field name="goComponentTerm" type="text" indexed="true" stored="true" multiValued="true" omitNorms="true" />
  <field name="goTerm" type="text" indexed="true" stored="false" multiValued="true" omitNorms="true" />
  <field name="interProTerm" type="text" indexed="true" stored="true" multiValued="true" omitNorms="true" />
  <field name="markerTermID" type="textTight" indexed="true" stored="false" multiValued="true" />
  <!-- phenotype fields -->
  <field name="phenoId" type="textTight" indexed="true" stored="true" multiValued="true" omitNorms="true" />
  <field name="phenoText" type="text" indexed="true" stored="true" multiValued="true" omitNorms="true" />


  <!-- specific nomen types -->
  <field name="currentSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="currentName" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="alleleSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="alleleName" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="alleleSynonym" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="oldSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="oldName" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="synonym" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="humanSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="humanName" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="humanSynonym" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="relatedSynonym" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="ratSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="ratSynonym" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="rhesusMacaqueSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="cattleSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="dogSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="zebrafishSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="chickenSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="chimpanzeeSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />
  <field name="westernClawedFrogSymbol" type="nomen" indexed="true" stored="true" multiValued="true"   />

  <!-- location -->
  <field name="chromosome" type="lowercase" indexed="true" stored="true" />
  <field name="genomic_chromosome" type="lowercase" indexed="true" stored="true" />
  <field name="genetic_chromosome" type="lowercase" indexed="true" stored="true" />
  <field name="cm" type="pdouble" indexed="true" stored="true" />
  <field name="startCoord" type="pint" indexed="true" stored="true" />
  <field name="endCoord" type="pint" indexed="true" stored="true" />
  <field name="strand" type="string" indexed="false" stored="true" />
  <field name="coordinateDisplay" type="string" indexed="false" stored="true" />
  <field name="locationDisplay" type="string" indexed="false" stored="true" />

  <field name="referenceKey" type="string" indexed="true" stored="false" multiValued="true" />

  <!-- sorts -->
  <field name="bySymbol" type="pint" indexed="true" stored="false" />
  <field name="byLocation" type="pint" indexed="true" stored="false" />

  <!-- This is a Solr-required field -->
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <copyField source="humanName" dest="markerNomen" />
  <copyField source="humanSynonym" dest="markerNomen" />
  <copyField source="humanSymbol" dest="markerNomen" />
  <copyField source="ratSymbol" dest="markerNomen" />
  <copyField source="ratSynonym" dest="markerNomen" />
  <copyField source="cattleSymbol" dest="markerNomen" />
  <copyField source="chickenSymbol" dest="markerNomen" />
  <copyField source="chimpanzeeSymbol" dest="markerNomen" />
  <copyField source="westernClawedFrogSymbol" dest="markerNomen" />
  <copyField source="dogSymbol" dest="markerNomen" />
  <copyField source="rhesusMacaqueSymbol" dest="markerNomen" />
  <copyField source="zebrafishSymbol" dest="markerNomen" />
  <copyField source="currentSymbol" dest="markerNomen" />
  <copyField source="currentName" dest="markerNomen" />
  <copyField source="oldSymbol" dest="markerNomen" />
  <copyField source="synonym" dest="markerNomen" />
  <copyField source="relatedSynonym" dest="markerNomen" />
  <copyField source="oldName" dest="markerNomen" />
  <copyField source="alleleSymbol" dest="markerNomen" />
  <copyField source="alleleName" dest="markerNomen" />
  <copyField source="alleleSynonym" dest="markerNomen" />

  <copyField source="goProcessTerm" dest="goTerm" />
  <copyField source="goFunctionTerm" dest="goTerm" />
  <copyField source="goComponentTerm" dest="goTerm" />

  <uniqueKey>markerKey</uniqueKey>

<!-- end custom data for this index -->



</schema>
