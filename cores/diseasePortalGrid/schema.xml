<?xml version="1.0" encoding="UTF-8" ?>
<schema name="authorsAC" version="1.7">
  
  <!-- Field Types -->
  <fieldType name="ancestor_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
  </fieldType>
  <fieldType name="binary" class="solr.BinaryField"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="descendent_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="ignored" class="solr.StrField" indexed="false" stored="false" multiValued="true"/>
 
<!-- TODO: These fail on load (-pf) 
 <fieldType name="location" class="solr.LatLonType" subFieldSuffix="_coordinate"/>
  <fieldType name="location_rpt" class="solr.SpatialRecursivePrefixTreeFieldType" geo="true" maxDistErr="0.001" distErrPct="0.025" distanceUnits="kilometers"/>
-->

<fieldType name="lowercase" class="solr.SortableTextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="phonetic_en" class="solr.TextField" indexed="true" stored="false">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.DoubleMetaphoneFilterFactory" inject="false"/>
    </analyzer>
  </fieldType>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="point" class="solr.PointType" subFieldSuffix="_d" dimension="2"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>    
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>


<!-- begin custom data for this index -->

  <fieldType name="nomen" class="solr.SortableTextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
    </analyzer>
  </fieldType>

  <fieldType name="pheno" class="solr.SortableTextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive="0"/>
    </analyzer>
  </fieldType>

  <fieldType name="geneticLocation"
    class="solr.SpatialRecursivePrefixTreeFieldType"
    multiValued="true"
    geo="false"
    worldBounds="-100000000000 -100000000000 100000000000 100000000000"
    distErrPct="0"
    maxDistErr="0.009"
    distanceUnits="degrees" />

  <fieldType name="textTight" class="solr.SortableTextField" positionIncrementGap="100" >
    <analyzer>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <!-- this filter can remove any duplicate tokens that appear at the same position - sometimes
           possible with WordDelimiterFilter in conjuncton with stemming. -->
      <filter class="solr.RemoveDuplicatesTokenFilterFactory"/>
    </analyzer>
  </fieldType>
  <field name="gridClusterKey" type="pint" indexed="true" stored="true" />

  <!-- marker centric fields -->
  <field name="markerKey" type="pint" indexed="true" stored="false" multiValued="true" />
  <field name="markerSymbol" type="nomen" indexed="true" stored="true" multiValued="true" />
  <field name="markerName" type="nomen" indexed="true" stored="true" multiValued="true" />
  <field name="filterableFeatureTypes" type="string" indexed="true" stored="true" multiValued="true" />
  <!-- mSy = markerSynonym ; shortened for efficiency -->
  <field name="mSy" type="nomen" indexed="true" stored="false" multiValued="true" />
  <field name="mSySingleToken" type="nomen" indexed="true" stored="false" multiValued="true" />
  <!-- mI = markerId ; shortened for efficiency -->
  <field name="mI" type="textTight" indexed="true" stored="false" multiValued="true" />
  <!-- oN = orthologNomen ; shortened for efficiency -->
  <field name="oN" type="nomen" indexed="true" stored="false" multiValued="true" />
  <!-- oS = orthologSymbol ; shortened for efficiency -->
  <field name="oS" type="nomen" indexed="true" stored="false" multiValued="true" />
  <!-- oS = orthologSynonym ; shortened for efficiency -->
  <field name="oSy" type="nomen" indexed="true" stored="false" multiValued="true" />
  <!-- oI = orthologId ; shortened for efficiency -->
  <field name="oI" type="textTight" indexed="true" stored="false" multiValued="true" />

  <!-- fields for searching by expressed component markers -->
  <field name="ecSymbol" type="nomen" indexed="true" stored="false" multiValued="true" />
  <field name="ecName" type="nomen" indexed="true" stored="false" multiValued="true" />
  <field name="ecId" type="textTight" indexed="true" stored="false" multiValued="true" />
  <field name="ecSynonym" type="nomen" indexed="true" stored="false" multiValued="true" />
  <field name="ecSynonymSingleToken" type="nomen" indexed="true" stored="false" multiValued="true" />

  <!-- aggregate marker fields -->
  <!-- mnS =  markerNomenSearch; shortened for efficiency -->
  <field name="mnS" type="nomen" indexed="true" stored="false" multiValued="true" />
  <!-- miS =  markerIdSearch; shortened for efficiency -->
  <field name="miS" type="textTight" indexed="true" stored="false" multiValued="true" />

  <!-- term centric fields -->
  <field name="term" type="pheno" indexed="true" stored="true" multiValued="true" />
  <field name="termId" type="pheno" indexed="true" stored="true" multiValued="true" />
  <field name="termType" type="string" indexed="true" stored="true" multiValued="true" />
  <field name="termHeader" type="pheno" indexed="true" stored="true" multiValued="true" />
  <!-- tSy =  termSynonym; shortened for efficiency -->
  <field name="tSy" type="pheno" indexed="true" stored="false" multiValued="true" />

  <!-- tAtext =  termAncestor (text only) -->
  <field name="tAtext" type="pheno" indexed="true" stored="false" multiValued="true" />
  <!-- tAid =  termAncestor (IDs only) -->
  <field name="tAid" type="textTight" indexed="true" stored="false" multiValued="true" />

  <field name="altTermId" type="pheno" indexed="true" stored="false" multiValued="true" />

  <!-- mpTermForDisease (text only) only applies to termType:DO -->
  <field name="mpDtext" type="pheno" indexed="true" stored="false" multiValued="true" />
  <!-- mpTermForDisease (IDs only) only applies to termType:DO -->
  <field name="mpDid" type="textTight" indexed="true" stored="false" multiValued="true" />

  <!-- doTermForDisease (text only) only applies to termType:DO via SS (super-simple) genotypes and brings back disease terms of the same SS genotype -->
  <field name="dDtext" type="pheno" indexed="false" stored="false" multiValued="true" />
  <!-- doTermForDisease (IDs only) only applies to termType:DO via SS (super-simple) genotypes and brings back disease terms of the same SS genotype -->
  <field name="dDid" type="textTight" indexed="false" stored="false" multiValued="true" />

  <!-- tsDtext =  termSearchForDisease (text only) -->
  <field name="tsDtext" type="pheno" indexed="true" stored="false" multiValued="true" omitNorms="true"/>
  <!-- tsDid =  termSearchForDisease (IDs only) -->
  <field name="tsDid" type="textTight" indexed="true" stored="false" multiValued="true" omitNorms="true"/>

  <!-- hpoText = HPO terms associated with disease (only for human marker/disease associations) -->
  <field name="hpoText" type="pheno" indexed="true" stored="false" multiValued="true" omitNorms="true"/>
  <!-- hpoId = IDs for HPO terms associated with disease (only for human marker/disease associations) -->
  <field name="hpoId" type="textTight" indexed="true" stored="false" multiValued="true" omitNorms="true"/>

   <!-- unique identifier for each document -->
  <field name="uniqueKey" type="string" indexed="true" stored="true" required="true" />

  <!-- *** now fields specific to the grid *** -->

  <!-- comma-separated list of allele pairs -->
  <field name="allelePairs" type="string" indexed="false" stored="true"/>

  <!-- database key for the genocluster, if this is mouse data -->
  <field name="genoClusterKey" type="pint" indexed="true" stored="true" />

  <!-- allele and marker data for IMSR, if this is mouse data -->
  <field name="imsrAlleles" type="string" indexed="false" stored="true" />

  <!-- sequence num for the genocluster, if this is mouse data -->
  <field name="byGenoCluster" type="pint" indexed="true" stored="true" />

  <!-- flag to indicate if this genocluster is conditional (1) or not (0) -->
  <field name="isConditional" type="pint" indexed="false" stored="true" />

  <!-- the "primary key" for this document, identifying uniquely this
       genocluster/gridcluster pair (for mouse data) or the marker/disease
       pair (for human data) -->
  <field name="gridKey" type="pint" indexed="true" stored="true" />

  <!-- database key for the preferred homology cluster for this marker, for
       human data -->
  <field name="homologyClusterKey" type="pint" indexed="true" stored="true" />

  <!-- comma-separated list of marker data for generating display of grid;
       each marker is Symbol|ID -->
  <field name="gridMouseSymbols" type="string" indexed="false" stored="true" />
  <field name="gridHumanSymbols" type="string" indexed="false" stored="true" />

  <!-- symbol of the human marker, if this is a human marker/disease pair -->
  <field name="humanGene" type="string" indexed="false" stored="false" />

  <!-- This is a Solr-required field -->
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <copyField source="markerName" dest="mnS"/>
  <copyField source="markerSymbol" dest="mnS"/>
  <copyField source="mSy" dest="mnS"/>
  <copyField source="oN" dest="mnS"/>
  <copyField source="oS" dest="mnS"/>
  <copyField source="oSy" dest="mnS"/>
  <copyField source="ecSymbol" dest="mnS"/>
  <copyField source="ecName" dest="mnS"/>
  <copyField source="ecSynonym" dest="mnS"/>

  <copyField source="mI" dest="miS"/>
  <copyField source="markerSymbol" dest="miS"/>
  <copyField source="mSySingleToken" dest="miS"/>
  <copyField source="oS" dest="miS"/>
  <copyField source="oI" dest="miS"/>
  <copyField source="ecId" dest="miS"/>
  <copyField source="ecSymbol" dest="miS"/>
  <copyField source="ecSynonymSingleToken" dest="miS"/>

  <copyField source="term" dest="tsDtext"/>
  <copyField source="tSy" dest="tsDtext"/>
  <copyField source="tAtext" dest="tsDtext"/>
  <copyField source="mpDtext" dest="tsDtext"/>
  <copyField source="dDtext" dest="tsDtext"/>
  <copyField source="hpoText" dest="tsDtext"/>

  <copyField source="termId" dest="tsDid"/>
  <copyField source="altTermId" dest="tsDid"/>
  <copyField source="tAid" dest="tsDid"/>
  <copyField source="mpDid" dest="tsDid"/>
  <copyField source="dDid" dest="tsDid"/>
  <copyField source="hpoId" dest="tsDid"/>

  <uniqueKey>uniqueKey</uniqueKey>

<!-- end custom data for this index -->





</schema>
