<?xml version="1.0" encoding="UTF-8" ?>
<schema name="creAssayResult" version="1.7">
  
  <!-- Field Types -->
  <fieldType name="ancestor_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
  </fieldType>
  <fieldType name="binary" class="solr.BinaryField"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="descendent_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="ignored" class="solr.StrField" indexed="false" stored="false" multiValued="true"/>
 
<!-- TODO: These fail on load (-pf) 
 <fieldType name="location" class="solr.LatLonType" subFieldSuffix="_coordinate"/>
  <fieldType name="location_rpt" class="solr.SpatialRecursivePrefixTreeFieldType" geo="true" maxDistErr="0.001" distErrPct="0.025" distanceUnits="kilometers"/>
-->

  <fieldType name="lowercase" class="solr.SortableTextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="phonetic_en" class="solr.TextField" indexed="true" stored="false">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.DoubleMetaphoneFilterFactory" inject="false"/>
    </analyzer>
  </fieldType>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="point" class="solr.PointType" subFieldSuffix="_d" dimension="2"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="text_general" class="solr.SortableTextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>    
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>


<!-- begin custom data for this index -->

  <!-- custom anatomy search field type -->
  <fieldType name="anatomy" class="solr.SortableTextField" positionIncrementGap="1000">
    <analyzer type="index">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive
="0"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.WordDelimiterFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="1" splitOnNumerics="0" catenateAll="0" splitOnCaseChange="0" preserveOriginal="1" stemEnglishPossessive
="0"/>
    </analyzer>
  </fieldType>

  <!-- Allele fields -->
  <field name="allID" type="string" indexed="true" stored="false" />
  <field name="alleleKey" type="string" indexed="true" stored="true" required="true" />
  <field name="byAllSymbol" type="pint" indexed="true" stored="false" />
  <field name="byAlleleType" type="pint" indexed="true" stored="false" />
  <field name="imsrCount" type="pint" indexed="true" stored="false"/>
  <field name="alleleSystemDetected" type="string" indexed="true" stored="true" multiValued="true" />
  <field name="alleleSystemNotDetected" type="string" indexed="true" stored="true"  multiValued="true" />

  <!-- Driver fields -->
  <field name="driver" type="lowercase" indexed="true" stored="true" />
  <field name="driverSearch" type="lowercase" indexed="true" stored="true" multiValued="true" />
  <field name="driverFacet" type="string" indexed="true" stored="true" />
  <!-- copyfield for driver -->
  <field name="driverExact" type="string" indexed="true" stored="true" />
  <field name="byReferenceCount" type="pint" indexed="true" stored="false" />
  <field name="byDriver" type="pint" indexed="true" stored="false" />
  <field name="inducer" type="string" indexed="true" stored="true" />

  <!-- System fields -->
  <field name="alleleSystemKey" type="string" indexed="true" stored="true" multiValued="true" />
  <field name="system" type="string" indexed="true" stored="true" multiValued="true" />
  <!-- For system level highlighting -->
  <field name="systemHlGroup" type="string" indexed="true" stored="true" />

  <!-- Result fields -->
  <field name="resultKey" type="string" indexed="true" stored="true" required="true" />
  <field name="annotatedStructure" type="string" indexed="true" stored="true" />
  <field name="annotatedStructureKey" type="string" indexed="true" stored="true" />
  <field name="structureSearch" type="anatomy" indexed="true" stored="true" multiValued="true" />
  <field name="detected" type="boolean" indexed="true" stored="true" required="true" />
  <field name="structureId" type="string" indexed="true" stored="false" multiValued="true" />
  <field name="structureKey" type="string" indexed="true" stored="false" multiValued="true" />

  <!-- All EMAPA structures where recombinase activity is directly detected.  -->
  <field name="allStructuresDirect" type="anatomy" indexed="true" stored="true" multiValued="true" />
  <!-- All EMAPA structures (and their ancestors) where recombinase activity is detected.  -->
  <field name="allStructures" type="anatomy" indexed="true" stored="true" multiValued="true" />

  <!-- For system level highlighting -->
  <field name="cellTypeHlGroup" type="string" indexed="true" stored="true" />
  <!-- Cell type annotated by this result -->
  <field name="annotatedCellType" type="string" indexed="true" stored="true" />
  <!-- Keys of the annotatedCellType and its ancestors -->
  <field name="cellTypeSearch" type="string" indexed="true" stored="true" multiValued="true" />
  <!-- Header cell types for the annotatedCellType -->
  <field name="cellTypeHeaders" type="string" indexed="true" stored="true" multiValued="true" />
  <!-- All cell types (and their ancestors) where recombinase activity is detected for this allele.  -->
  <field name="allCellTypes" type="string" indexed="true" stored="true" multiValued="true" />

  <!-- terms containing all of the allele's detected recombinase activity:
       There will be no recombinase activity for the allele detected outside
       each of these structures.  (This will be a path of terms from the root
       down.)  -->
  <field name="exclusiveStructures" type="anatomy" indexed="true" stored="true" multiValued="true" />

  <!-- pre-computed fields for sorting by different data attributes -->

  <field name="byStructure" type="pint" indexed="true" stored="false" />
  <field name="byAge" type="pint" indexed="true" stored="false" />
  <field name="byLevel" type="pint" indexed="true" stored="false" />
  <field name="byPattern" type="pint" indexed="true" stored="false" />
  <field name="byJnumID" type="pint" indexed="true" stored="false" />
  <field name="byAssayType" type="pint" indexed="true" stored="false" />
  <field name="byReporterGene" type="pint" indexed="true" stored="false" />
  <field name="byDetectionMethod" type="pint" indexed="true" stored="false" />
  <field name="byAssayNote" type="pint" indexed="true" stored="false" />
  <field name="byAllelicComposition" type="pint" indexed="true" stored="false" />
  <field name="bySex" type="pint" indexed="true" stored="false" />
  <field name="bySpecimenNote" type="pint" indexed="true" stored="false" />
  <field name="byResultNote" type="pint" indexed="true" stored="false" />
  <field name="byDetected" type="pint" indexed="true" stored="false" />
  <field name="byNotDetected" type="pint" indexed="true" stored="false" />

  <!-- This is a Solr-required field -->
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <copyField source="driver" dest="driverExact" />

  <uniqueKey>resultKey</uniqueKey>

<!-- end custom data for this index -->




</schema>
