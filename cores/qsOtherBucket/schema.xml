<?xml version="1.0" encoding="UTF-8" ?>
<schema name="qsOtherBucket" version="1.7">
  
  <!-- Field Types -->
  <fieldType name="ancestor_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
  </fieldType>
  <fieldType name="binary" class="solr.BinaryField"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="booleans" class="solr.BoolField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="descendent_path" class="solr.TextField">
    <analyzer type="index">
      <tokenizer class="solr.PathHierarchyTokenizerFactory" delimiter="/"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.KeywordTokenizerFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="ignored" class="solr.StrField" indexed="false" stored="false" multiValued="true"/>
 
<!-- TODO: These fail on load (-pf) 
 <fieldType name="location" class="solr.LatLonType" subFieldSuffix="_coordinate"/>
  <fieldType name="location_rpt" class="solr.SpatialRecursivePrefixTreeFieldType" geo="true" maxDistErr="0.001" distErrPct="0.025" distanceUnits="kilometers"/>
-->

  <fieldType name="lowercase" class="solr.TextField" positionIncrementGap="100">
    <analyzer>
      <tokenizer class="solr.KeywordTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>
  <fieldType name="phonetic_en" class="solr.TextField" indexed="true" stored="false">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.DoubleMetaphoneFilterFactory" inject="false"/>
    </analyzer>
  </fieldType>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>
  <fieldType name="pdates" class="solr.DatePointField" docValues="true" multiValued="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdoubles" class="solr.DoublePointField" docValues="true" multiValued="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pfloats" class="solr.FloatPointField" docValues="true" multiValued="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="pints" class="solr.IntPointField" docValues="true" multiValued="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="plongs" class="solr.LongPointField" docValues="true" multiValued="true"/>
  <fieldType name="point" class="solr.PointType" subFieldSuffix="_d" dimension="2"/>
  <fieldType name="random" class="solr.RandomSortField" indexed="true"/>
  <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true"/>
  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>    
    <analyzer type="query">
      <tokenizer name="standard"/>
      <filter name="lowercase"/>
    </analyzer>
  </fieldType>

<!-- begin custom data for this index -->

  <fieldType name="textTight" class="solr.TextField" positionIncrementGap="100" >
    <analyzer>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <!-- this filter can remove any duplicate tokens that appear at the same position - sometimes
           possible with WordDelimiterFilter in conjuncton with stemming. -->
      <filter class="solr.RemoveDuplicatesTokenFilterFactory"/>
    </analyzer>
  </fieldType>

  <fieldType name="termType" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="(')" replacement=""/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="(-)" replacement=" "/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="(/)" replacement=" "/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="([^a-zA-Z0-9\s])" replacement=""/>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="(')" replacement=""/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="-" replacement=" "/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="/" replacement=" "/>
      <charFilter class="solr.PatternReplaceCharFilterFactory" pattern="([^a-zA-Z0-9\s])" replacement=""/>
      <tokenizer class="solr.WhitespaceTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

<!-- fields related to searching by text: Either searchTermExact, searchTermInexact, or searchTermStemmed
        should be populated for documents to be searched by text. -->

  <field name="uniqueKey" type="string" indexed="true" stored="true" required="true" />
  <field name="searchTermExact" type="lowercase" indexed="true" stored="true" required="false" />
  <field name="searchTermInexact" type="textTight" indexed="true" stored="true" required="false" />
  <field name="searchTermStemmed" type="termType" indexed="true" stored="true" required="false" />
  <field name="searchTermDisplay" type="string" indexed="false" stored="true" required="true" />
  <field name="searchTermType" type="string" indexed="true" stored="true" required="true" />
  <field name="searchTermWeight" type="pint" indexed="true" stored="true" required="true" />

<!-- fields related to searching by coordinates (human and mouse in separate documents): These should only
        be filled in for documents to be searched by coordinates. -->

  <field name="searchCoordType" type="string" indexed="true" stored="true" required="false" />
  <field name="searchChromosome" type="string" indexed="true" stored="true" required="false" />
  <field name="searchStartCoord" type="plong" indexed="true" stored="true" required="false" />
  <field name="searchEndCoord" type="plong" indexed="true" stored="true" required="false" />
  <field name="coordSequenceNum" type="plong" indexed="true" stored="true" required="false" />

<!-- fields related to display -->

  <field name="primaryID" type="string" indexed="true" stored="true" required="true" />
  <field name="name" type="termType" indexed="true" stored="true" required="false" />
  <field name="objectType" type="string" indexed="true" stored="true" required="true" />
  <field name="objectSubType" type="string" indexed="true" stored="true" required="false" />
  <field name="detailUri" type="string" indexed="false" stored="true" required="false" />
  <field name="sequenceNum" type="plong" indexed="true" stored="true" required="false" />

<!-- fields related to filtering, must be kept in sync with other Quick Search buckets -->

  <field name="goProcessFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="goFunctionFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="goComponentFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="diseaseFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="phenotypeFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="markerTypeFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />
  <field name="expressionFacets" type="strings" indexed="true" stored="true" required="false" multiValued="true" />

  <!-- This is a Solr-required field -->
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <uniqueKey>uniqueKey</uniqueKey>

<!-- end custom data for this index -->


</schema>
